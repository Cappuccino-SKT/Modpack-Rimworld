              <li><tag>CBF_Vanilla_Smithy</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Workhall</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_Armory</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_PrestigeArmory</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_CommandCenter</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_Barracks</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_StorageHall</tag><count>1~2</count></li>
              <li MayRequire="OskarPotocki.VanillaVehiclesExpanded"><tag>CBF_Vanilla_Garage</tag><count>1~2</count></li>
              <li MayRequire="OskarPotocki.VanillaVehiclesExpanded"><tag>CBF_Vanilla_MotorPool</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_EnergyProduction</tag><count>2~3</count></li>
