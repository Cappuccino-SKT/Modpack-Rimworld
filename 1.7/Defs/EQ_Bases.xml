    <roadLane>2</roadLane>
    <minBuildingGap>0</minBuildingGap>
    <openTerrain>true</openTerrain>
    <towerCorner>7</towerCorner>
    <defendersOnWall>0.3</defendersOnWall>
    <ideoStyle>true</ideoStyle>
    <worldTexture>World/WorldObjects/CBF/CBF_ModernCity</worldTexture>
    <wdLevel>3</wdLevel>
    <wards>
      <li>
        <kind>Town</kind>
