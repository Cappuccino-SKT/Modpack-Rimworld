  <!-- ===================================================================== SILÊNCIO: arquivo-bunker -->
  <!-- Bibliotecas, laboratórios, cofres e uma prisão de "voluntários". Pouca lavoura (comem ração). -->
  <CustomBaseFramework.SettlementPlanDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Plan_Silencio</defName>
    <label>arquivo da Ordem</label>
    <kind>ModernTown</kind>
    <materialList>CBF_Modern_MaterialList</materialList>
    <styles><li>CBF_ModernVanilla</li></styles>
    <factionTags><li>EQ_Faction_Silencio</li></factionTags>
    <share>1</share>
    <vehicles>0</vehicles>
    <defenderPoints>1200</defenderPoints>
    <wealthFactor>0.2</wealthFactor>
    <coreSize>70~84</coreSize>
    <mapSize>200</mapSize>
    <roadMain>4</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <openTerrain>true</openTerrain>
    <towerCorner>7</towerCorner>
    <defendersOnWall>0.2</defendersOnWall>
    <ideoStyle>true</ideoStyle>
    <worldTexture>World/WorldObjects/CBF/CBF_ModernVillage</worldTexture>
    <wdLevel>2</wdLevel>
    <wards>
      <li>
        <kind>Town</kind>
        <name>Arquivo</name>
        <label>arquivo</label>
        <supply>1.2</supply>
        <roads><li>Concrete</li></roads>
        <roadEdges><li>PavedTile</li></roadEdges>
        <walls>
          <li><piece>CBF_Vanilla_Line_Barricade</piece><weight>1</weight></li>
        </walls>
        <emplacements>
          <li><tag>CBF_Vanilla_SandbagPosition</tag><count>2~3</count></li>
        </emplacements>
        <garrison>
          <li><list>EQ_Garrison_Silencio_Muro</list><count>4~6</count><post>Walkway</post></li>
          <li><list>EQ_Garrison_Silencio</list><count>6~9</count><post>Inside</post></li>
          <li><list>EQ_Garrison_Silencio_Cobaias</list><count>2~4</count><post>Inside</post></li>
        </garrison>
        <defenses>
          <li><tag>CBF_Vanilla_Defense_Small</tag><count>2~3</count></li>
        </defenses>
        <districts>
          <li>
            <name>Acervo</name>
            <entries>
              <li><tag>CBF_Vanilla_ResearchCenter</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Research</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Outpost_Library</tag><count>2~3</count></li>
              <li><tag>CBF_Vanilla_Outpost_Study</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Vault</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Prison</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_Hospital</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Barracks</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_StorageHall</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Kitchen</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_EnergyProduction</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_HouseSmall</tag><count>4~8</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Arredores</name>
        <supply>1</supply>
        <roads><li>Concrete</li></roads>
        <districts>
          <li>
            <name>Arredores</name>
            <entries>
              <li><tag>CBF_Vanilla_Graveyard</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_Hydroponics</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_SolarPark</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
  </CustomBaseFramework.SettlementPlanDef>

  <!-- ===================================================================== HÉLICE: filial corporativa -->
  <!-- Sede (banco), clínicas, laboratório de drogas, posto de vendas e apartamentos para o "capital humano". -->
  <CustomBaseFramework.SettlementPlanDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Plan_Helice</defName>
    <label>filial da Hélice</label>
    <kind>ModernTown</kind>
    <materialList>CBF_Modern_MaterialList</materialList>
    <styles><li>CBF_ModernVanilla</li></styles>
    <factionTags><li>EQ_Faction_Helice</li></factionTags>
    <share>1</share>
    <vehicles>0~1</vehicles>
    <defenderPoints>800</defenderPoints>
    <wealthFactor>0.3</wealthFactor>
    <coreSize>66~80</coreSize>
    <mapSize>200</mapSize>
    <roadMain>5</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <openTerrain>true</openTerrain>
    <ideoStyle>true</ideoStyle>
    <worldTexture>World/WorldObjects/CBF/CBF_ModernVillage</worldTexture>
    <wdLevel>2</wdLevel>
    <wards>
      <li>
        <kind>Town</kind>
        <name>Sede</name>
        <label>sede</label>
        <supply>1.3</supply>
        <roads><li>Concrete</li></roads>
        <roadEdges><li>PavedTile</li></roadEdges>
        <garrison>
          <li><list>EQ_Garrison_Helice</list><count>7~10</count><post>Inside</post></li>
          <li><list>EQ_Garrison_Helice_Elite</list><count>1~3</count><post>Inside</post></li>
        </garrison>
        <defenses>
          <li><tag>CBF_Vanilla_Defense_Small</tag><count>2~4</count></li>
        </defenses>
        <districts>
          <li>
            <name>Filial</name>
            <entries>
              <li><tag>CBF_Vanilla_GrandBank</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_Clinic</tag><count>2~3</count></li>
              <li><tag>CBF_Vanilla_Hospital</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_DrugLab</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_ResearchCenter</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_TradingPost</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_ApartmentBlock</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_TownHouse</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Tavern</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_EnergyStorage</tag><count>1</count></li>
              <li><tag>CBF_Vanilla_EnergyProduction</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_HouseLarge</tag><count>3~6</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Cultivo</name>
        <supply>1</supply>
        <roads><li>Concrete</li></roads>
        <districts>
          <li>
            <name>Cultivo</name>
            <fields>
              <li>
                <count>2~3</count>
                <fence>false</fence>
                <weight>1</weight>
                <plants>
                  <li>Plant_Healroot</li>
                  <li>Plant_Rice</li>
                </plants>
                <tags><li>CBF_ModernFarmHouse</li></tags>
              </li>
            </fields>
            <entries>
              <li><tag>CBF_Vanilla_Hydroponics</tag><count>1</count></li>
              <li><piece>CBF_Modern_Farmhouse</piece><count>1~2</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
  </CustomBaseFramework.SettlementPlanDef>

  <!-- ===================================================================== FORJA: fábrica-fortaleza -->
  <!-- Oficinas, arsenal, quartel, garagem e usina; muralha, torres pesadas e veículos. -->
