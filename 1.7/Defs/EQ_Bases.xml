<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Bases das 4 potências (Custom Base Framework). Um plano com factionTags = a nossa FactionDef tira a potência
       dos planos genéricos do CBF (ver EcosDaQueda-Dev/mods/frameworks/custom-base-framework.md).
       Os prédios são os do CBF (etiquetas CBF_Vanilla_*); a composição, as defesas e a guarnição são nossas.
       Sem o CBF, tudo aqui é ignorado (MayRequire) e as bases voltam a ser as do jogo. -->

  <!-- ===================================================================== GUARNIÇÕES -->

  <CustomBaseFramework.PawnListDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Garrison_Silencio</defName>
    <label>guarda do arquivo</label>
    <role>Guard</role>
    <radius>6</radius>
    <members>
      <li><kind>EQ_Silencio_Guardiao</kind><weight>4</weight></li>
      <li><kind>EQ_Silencio_Acolito</kind><weight>3</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>
  <CustomBaseFramework.PawnListDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Garrison_Silencio_Muro</defName>
    <label>sentinelas da contenção</label>
    <role>Sentry</role>
    <radius>4</radius>
    <members>
      <li><kind>EQ_Silencio_Guardiao</kind><weight>1</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>
  <CustomBaseFramework.PawnListDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Garrison_Silencio_Cobaias</defName>
    <label>voluntários de pesquisa</label>
    <role>Civilian</role>
    <radius>6</radius>
    <members>
      <li><kind>EQ_Silencio_Cobaia</kind><weight>1</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>

  <CustomBaseFramework.PawnListDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Garrison_Helice</defName>
    <label>segurança corporativa</label>
    <role>Guard</role>
    <radius>6</radius>
    <members>
      <li><kind>EQ_Helice_Fiscal</kind><weight>4</weight></li>
      <li><kind>EQ_Helice_Estagiario</kind><weight>3</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>
  <CustomBaseFramework.PawnListDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Garrison_Helice_Elite</defName>
    <label>protótipos em exposição</label>
    <role>Guard</role>
    <radius>6</radius>
    <members>
      <li><kind>EQ_Helice_Prototipo</kind><weight>1</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>

  <CustomBaseFramework.PawnListDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Garrison_Forja</defName>
    <label>turno da fábrica</label>
    <role>Guard</role>
    <radius>6</radius>
    <members>
      <li><kind>EQ_Forja_Cavaleiro</kind><weight>4</weight></li>
      <li><kind>EQ_Forja_Aprendiz</kind><weight>3</weight></li>
      <li><kind>EQ_Forja_Tecnico</kind><weight>1</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>
  <CustomBaseFramework.PawnListDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Garrison_Forja_Muro</defName>
    <label>vigias da linha de montagem</label>
    <role>Sentry</role>
    <radius>4</radius>
    <members>
      <li><kind>EQ_Forja_Cavaleiro</kind><weight>1</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>
  <CustomBaseFramework.PawnListDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Garrison_Forja_Elite</defName>
    <label>cavaleiros lacrados</label>
    <role>Guard</role>
    <radius>6</radius>
    <members>
      <li><kind>EQ_Forja_Lacrado</kind><weight>1</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>

  <CustomBaseFramework.PawnListDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Garrison_Coro</defName>
    <label>guarda de honra</label>
    <role>Guard</role>
    <radius>6</radius>
    <members>
      <li><kind>EQ_Coro_Tenor</kind><weight>4</weight></li>
      <li><kind>EQ_Coro_Corista</kind><weight>3</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>
  <CustomBaseFramework.PawnListDef MayRequire="EvilEyeGuy.CustomBaseFramework">
    <defName>EQ_Garrison_Coro_Elite</defName>
    <label>sopranos da corte</label>
    <role>Guard</role>
    <radius>6</radius>
