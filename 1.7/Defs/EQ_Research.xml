<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Etapa 3: árvore de pesquisa própria. Cada projeto cai num ramo (EcosDaQueda.ResearchBranchDef):
       1º projects (lista explícita de qualquer ramo), 2º mods (packageId; exceto exceptProjects), 3º techLevels, senão o ramo "free".
       O ramo leva o projeto para a aba dele (menos os da Anomaly, que ficam na aba própria) e, fora da bancada, trava a pesquisa
       até o jogador ter acesso (licença, sucata, dados antigos; bloco 3a: só por debug). Listas geradas por scripts/research-classify.py. -->

  <ResearchTabDef>
    <defName>EQ_Tab_Bancada</defName>
    <label>Bancada</label>
    <generalTitle>Bancada</generalTitle>
    <generalDescription>O que dá para inventar com ferramenta, paciência e um manual de instruções rasgado: do arco à microeletrônica. Daqui em diante, ninguém inventa nada; recupera, copia ou paga licença.</generalDescription>
  </ResearchTabDef>

  <ResearchTabDef>
    <defName>EQ_Tab_VelhoMundo</defName>
    <label>Velho Mundo</label>
    <generalTitle>Tecnologia do Velho Mundo</generalTitle>
    <generalDescription>Coisas que ninguém sabe mais fazer e que nenhuma potência registrou ainda. Só saem de sucata desmontada com cuidado ou de dados antigos achados num abrigo.</generalDescription>
  </ResearchTabDef>

  <ResearchTabDef>
    <defName>EQ_Tab_Silencio</defName>
    <label>Silêncio</label>
    <generalTitle>Arquivo do Silêncio</generalTitle>
    <generalDescription>Tudo o que o Silêncio guarda no arquivo: sensores, a escuta, e o que sobrou de pesquisa sobre o Vazio. Licença por cargo ou por favor; o resto é pirataria.</generalDescription>
  </ResearchTabDef>

  <ResearchTabDef>
    <defName>EQ_Tab_Helice</defName>
    <label>Hélice</label>
    <generalTitle>Patentes da Hélice</generalTitle>
    <generalDescription>Genética, próteses, implantes e a colmeia. Cada gene tem dono, e o dono cobra royalties até de quem nasceu com ele.</generalDescription>
  </ResearchTabDef>

  <ResearchTabDef>
    <defName>EQ_Tab_Forja</defName>
    <label>Forja</label>
    <generalTitle>Catálogo da Forja</generalTitle>
    <generalDescription>Mecanoides, veículos de combate, armaduras, armas de energia e o que mais couber num manual de garantia. Montar sem licença anula a garantia e chama a fiscalização.</generalDescription>
  </ResearchTabDef>

  <ResearchTabDef>
    <defName>EQ_Tab_Coro</defName>
    <label>Coro</label>
    <generalTitle>Tesouro do Coro</generalTitle>
    <generalDescription>Eltex, itens nobres e a música da corte. O Coro não vende tecnologia: concede, a quem se curvar.</generalDescription>
  </ResearchTabDef>

  <EcosDaQueda.ResearchBranchDef>
    <defName>EQ_Ramo_Bancada</defName>
    <label>Bancada</label>
    <labelOf>da Bancada</labelOf>
    <tab>EQ_Tab_Bancada</tab>
    <order>0</order>
    <free>true</free>
  </EcosDaQueda.ResearchBranchDef>

