<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Relações fixas entre as 4 potências (lidas por EcosDaQueda.dll).
       Aplicadas uma vez por mundo (ao criar, ou na 1ª vez que um save antigo é carregado).
       goodwill <= -75 = hostis; >= 75 = aliados; entre os dois = neutros.
       permanentEnemies = hostilidade reimposta todo dia e, com o Hegemony, paz/tratados vetados. -->

  <EcosDaQueda.FactionRelationPresetDef>
    <defName>EQ_FactionRelations_Main</defName>
    <relations>
      <!-- O Silêncio estuda o que o Coro chama de heresia; o Coro queimaria as bibliotecas. -->
      <li>
        <a>EQ_Faction_Silencio</a>
        <b>EQ_Faction_Coro</b>
        <goodwill>-100</goodwill>
        <label>ódio mortal</label>
        <permanentEnemies>true</permanentEnemies>
      </li>
      <!-- A Forja confisca tecnologia; o Silêncio confisca técnicos. Guerra aberta, mas negociável. -->
      <li>
        <a>EQ_Faction_Silencio</a>
        <b>EQ_Faction_Forja</b>
        <goodwill>-85</goodwill>
        <label>guerra</label>
      </li>
      <!-- A Hélice compra cobaias do Silêncio... e desconfia de onde elas vêm. -->
      <li>
        <a>EQ_Faction_Silencio</a>
        <b>EQ_Faction_Helice</b>
        <goodwill>-30</goodwill>
        <label>desconfiança</label>
      </li>
      <!-- Carne contra metal: concorrentes no mesmo mercado de "melhorar pessoas". -->
      <li>
        <a>EQ_Faction_Helice</a>
        <b>EQ_Faction_Forja</b>
        <goodwill>-50</goodwill>
        <label>rivalidade</label>
      </li>
      <!-- O Coro precisa de herdeiros perfeitos; a Hélice precisa de clientes ricos. -->
      <li>
        <a>EQ_Faction_Helice</a>
        <b>EQ_Faction_Coro</b>
        <goodwill>45</goodwill>
        <label>aliança frágil</label>
      </li>
      <!-- Ignoram-se educadamente. Por enquanto. -->
      <li>
        <a>EQ_Faction_Forja</a>
        <b>EQ_Faction_Coro</b>
        <goodwill>0</goodwill>
        <label>neutralidade</label>
      </li>

      <!-- ===== Facções menores (Defs/Factions/EQ_MinorFactions.xml) ===== -->
      <!-- Androides despertos contra quem quer desmontá-los. Sem acordo possível. -->
      <li>
        <a>EQ_Faction_Forja</a>
        <b>EQ_Faction_ForaDeLinha</b>
        <goodwill>-100</goodwill>
        <label>recall contra terrorismo</label>
        <permanentEnemies>true</permanentEnemies>
      </li>
      <!-- O Silêncio caça o próprio acervo extraviado; o acervo morde de volta. -->
      <li>
        <a>EQ_Faction_Silencio</a>
        <b>EQ_Faction_NaoCatalogados</b>
        <goodwill>-100</goodwill>
        <label>caça ao acervo</label>
        <permanentEnemies>true</permanentEnemies>
      </li>
      <!-- Para o Coro, aberrações do Vazio são uma dissonância a apagar. -->
      <li>
        <a>EQ_Faction_Coro</a>
        <b>EQ_Faction_NaoCatalogados</b>
        <goodwill>-80</goodwill>
        <label>dissonância</label>
      </li>
      <!-- A Hélice compra amostras dos dois lados. -->
      <li>
        <a>EQ_Faction_Helice</a>
        <b>EQ_Faction_NaoCatalogados</b>
        <goodwill>-20</goodwill>
        <label>interesse comercial</label>
      </li>
      <li>
        <a>EQ_Faction_Helice</a>
        <b>EQ_Faction_ForaDeLinha</b>
        <goodwill>10</goodwill>
        <label>concorrente do concorrente</label>
      </li>
      <!-- A Feira Andante vende para todas as potências e não toma partido. -->
      <li>
        <a>EQ_Faction_FeiraAndante</a>
        <b>EQ_Faction_Silencio</b>
        <goodwill>35</goodwill>
        <label>fornecedora de papel e cobaias</label>
      </li>
      <li>
        <a>EQ_Faction_FeiraAndante</a>
        <b>EQ_Faction_Helice</b>
        <goodwill>35</goodwill>
        <label>revendedora autorizada</label>
      </li>
      <li>
        <a>EQ_Faction_FeiraAndante</a>
        <b>EQ_Faction_Forja</b>
        <goodwill>35</goodwill>
        <label>fornecedora de sucata</label>
      </li>
      <li>
        <a>EQ_Faction_FeiraAndante</a>
        <b>EQ_Faction_Coro</b>
        <goodwill>35</goodwill>
        <label>fornecedora da corte</label>
      </li>
      <!-- O Reino do Lodo: a Hélice quer o lote de volta; o Reino manda os fiscais para o Descarte. -->
      <li>
        <a>EQ_Faction_Helice</a>
        <b>EQ_Faction_ReinoDoLodo</b>
        <goodwill>-100</goodwill>
        <label>recall de lote</label>
        <permanentEnemies>true</permanentEnemies>
      </li>
      <!-- Para o Coro, o Reino é feio, desafinado e grita. -->
      <li>
        <a>EQ_Faction_Coro</a>
        <b>EQ_Faction_ReinoDoLodo</b>
        <goodwill>-60</goodwill>
        <label>desafinados de nascença</label>
      </li>
      <!-- O Silêncio quer uma amostra de cada geração. -->
      <li>
        <a>EQ_Faction_Silencio</a>
        <b>EQ_Faction_ReinoDoLodo</b>
        <goodwill>-25</goodwill>
        <label>interesse acadêmico</label>
      </li>
      <!-- A Forja vende ferro velho a quem paga e não pergunta pela garantia. -->
      <li>
        <a>EQ_Faction_Forja</a>
        <b>EQ_Faction_ReinoDoLodo</b>
        <goodwill>10</goodwill>
        <label>cliente sem garantia</label>
      </li>
      <!-- Clientes da Feira: compram tudo que brilha e pagam em porco. -->
      <li>
        <a>EQ_Faction_FeiraAndante</a>
        <b>EQ_Faction_ReinoDoLodo</b>
        <goodwill>30</goodwill>
        <label>pagam em porco</label>
      </li>
      <!-- Saqueadores contra saqueadores: concorrência desleal. -->
      <li>
        <a>EQ_Faction_SindicatoDoSaque</a>
        <b>EQ_Faction_ReinoDoLodo</b>
        <goodwill>-70</goodwill>
        <label>concorrência desleal</label>
      </li>
    </relations>
  </EcosDaQueda.FactionRelationPresetDef>

</Defs>
