    <!-- Ideologia fixa "A Esteira Sagrada" (Ideos/ReinoDoLodo.rid, via EQ_IdeoTemplates.xml) -->
    <fixedIdeo>true</fixedIdeo>
    <structureMemeWeights Inherit="False" />
    <requiredMemes Inherit="False" />
    <forcedMemes>
      <li MayRequire="Sarg.AlphaMemes">AM_Structure_Mesoamerican</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">MaleSupremacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
    </forcedMemes>
    <!-- Linhagem dos mutantes: machos (brutos) e fêmeas (brutas), ambos hereditários; gênero fixo pelo gene. -->
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <EQ_Xeno_Bruto>0.5</EQ_Xeno_Bruto>
        <EQ_Xeno_Bruta>0.5</EQ_Xeno_Bruta>
      </xenotypeChances>
    </xenotypeSet>
    <fixedLeaderKinds>
      <li>EQ_Lodo_Rei</li>
    </fixedLeaderKinds>
    <basicMemberKind>EQ_Lodo_Bruto</basicMemberKind>
    <maxPawnCostPerTotalPointsCurve Inherit="False">
      <points>
        <li>(0,45)</li>
        <li>(70,65)</li>
        <li>(700,150)</li>
        <li>(1300,250)</li>
        <li>(100000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers Inherit="False">
      <li>
        <!-- Leva de saque -->
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <EQ_Lodo_Bruto>10</EQ_Lodo_Bruto>
          <EQ_Lodo_Bacamarteiro>6</EQ_Lodo_Bacamarteiro>
          <EQ_Lodo_Arrombador>3</EQ_Lodo_Arrombador>
          <EQ_Lodo_Rei>0.4</EQ_Lodo_Rei>
        </options>
      </li>
      <li>
        <!-- Carga de chiqueiro: só corpo a corpo -->
