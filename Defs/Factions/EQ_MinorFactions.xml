  <!-- =====================================================================
       O REINO DO LODO: os mutantes. Linha Robusta descontinuada da Hélice que virou reino medieval nos
       pântanos poluídos. Armas antigas e de sucata. Ideologia fixa "A Esteira Sagrada".
       ===================================================================== -->
  <FactionDef ParentName="OutlanderFactionBase">
    <defName>EQ_Faction_ReinoDoLodo</defName>
    <label>O Reino do Lodo</label>
    <description>Antes da Queda, a Hélice vendia a Linha Robusta: operários verdes que comiam lixo tóxico e não pediam aumento. O lote foi descontinuado e esquecido nos pântanos poluídos. Os descendentes leram a ficha técnica do produto como escritura, fundaram um reino e coroaram um Rei-Capataz.\n\nO Reino do Lodo é medieval por falta de manual: madeira, ferro, bacamartes de cano de esgoto e mosquetes desenterrados de museu. Os brutos lutam, as brutas \"repõem\", a pesquisa é pecado e todo forasteiro é matéria-prima até prova em contrário.\n\nA Hélice quer o lote de volta e manda fiscais; o Reino manda os fiscais para o Descarte. Com os outros, o Reino comercia quando não está saqueando, o que também é uma forma de comércio.</description>
    <fixedName>O Reino do Lodo</fixedName>
    <factionNameMaker IsNull="True" />
    <caravanTraderKinds Inherit="False">
      <li MayRequire="OskarPotocki.VFE.Medieval2">VFEM2_Caravan_Medieval_Farmer</li>
      <li MayRequire="OskarPotocki.VFE.Medieval2">VFEM2_Caravan_Medieval_Weaponsmith</li>
      <li MayRequire="OskarPotocki.VFE.Medieval2">VFEM2_Caravan_Looter</li>
      <li>Caravan_Neolithic_WarMerchant</li>
    </caravanTraderKinds>
    <visitorTraderKinds Inherit="False">
      <li MayRequire="OskarPotocki.VFE.Medieval2">VFEM2_Visitor_Medieval_Standard</li>
      <li>Visitor_Neolithic_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds Inherit="False">
      <li MayRequire="OskarPotocki.VFE.Medieval2">VFEM2_Base_Medieval_Standard</li>
      <li>Base_Neolithic_Standard</li>
    </baseTraderKinds>
    <pawnSingular>bruto</pawnSingular>
    <pawnsPlural>brutos</pawnsPlural>
    <leaderTitle>rei-capataz</leaderTitle>
    <leaderTitleFemale>rainha-capataz</leaderTitleFemale>
    <categoryTag>EQ_ReinoDoLodo</categoryTag>
    <techLevel>Medieval</techLevel>
    <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
    <settlementNameMaker>EQ_NamerSettlement_ReinoDoLodo</settlementNameMaker>
    <colorSpectrum Inherit="False">
      <li>(0.45, 0.62, 0.22)</li>
      <li>(0.45, 0.62, 0.22)</li>
    </colorSpectrum>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <configurationListOrderPriority>17</configurationListOrderPriority>
    <listOrderPriority>44</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <canSiege>true</canSiege>
