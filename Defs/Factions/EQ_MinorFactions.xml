        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <EQ_Lodo_Bruto>10</EQ_Lodo_Bruto>
          <EQ_Lodo_Bacamarteiro>6</EQ_Lodo_Bacamarteiro>
          <EQ_Lodo_Arrombador>4</EQ_Lodo_Arrombador>
          <EQ_Lodo_Bruta>6</EQ_Lodo_Bruta>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="EcosDaQueda.MinorFactionExtension">
        <playerGoodwill>-30</playerGoodwill>
      </li>
    </modExtensions>
  </FactionDef>

  <!-- =====================================================================
