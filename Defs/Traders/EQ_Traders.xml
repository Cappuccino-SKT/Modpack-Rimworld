<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Comerciantes das nossas facções. Cada um começa com o estoque de um comerciante do jogo
       (TraderStockCopyExtension: já com a munição e os itens que os mods acrescentam por patch) e soma a mercadoria
       típica da facção. As armas e roupas vêm do arsenal dela (StockGenerator_EQTags), não do sortido genérico.
       Conferir: comando de debug "trader <TraderKindDef>". -->

  <!-- ===================== Silencio ===================== -->
  <TraderKindDef>
    <defName>EQ_Base_Silencio</defName>
    <label>arquivo da Ordem</label>
    <modExtensions>
      <li Class="EcosDaQueda.TraderStockCopyExtension">
        <copyFrom>Base_Outlander_Standard</copyFrom>
        <dropWeapons>true</dropWeapons>
      </li>
    </modExtensions>
    <stockGenerators>
      <li Class="StockGenerator_Category">
        <categoryDef>Books</categoryDef>
        <thingDefCountRange>2~3</thingDefCountRange>
        <countRange>1~2</countRange>
        <excludedThingDefs>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Tome</li>
        </excludedThingDefs>
      </li>
      <li Class="StockGenerator_Tomes" MayRequire="Ludeon.RimWorld.Anomaly">
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_SingleDef" MayRequire="Ludeon.RimWorld.Anomaly">
        <thingDef>Bioferrite</thingDef>
        <countRange>100~300</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>Serum</tradeTag>
        <thingDefCountRange>2~4</thingDefCountRange>
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_SingleDef" MayRequire="VanillaExpanded.VBrewE">
        <thingDef>VBE_RawCoffee</thingDef>
        <countRange>40~120</countRange>
      </li>
      <li Class="EcosDaQueda.StockGenerator_EQTags">
        <countRange>4~7</countRange>
        <weaponTags>
          <li>EQ_Silencio_Basico</li>
          <li>EQ_Silencio_Elite</li>
        </weaponTags>
        <apparelTags>
          <li>EQ_Roupa_Silencio</li>
          <li>EQ_Roupa_SilencioElite</li>
        </apparelTags>
      </li>
    </stockGenerators>
  </TraderKindDef>

