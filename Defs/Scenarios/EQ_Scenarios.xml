  <ScenarioDef ParentName="EQ_ScenarioBase">
    <defName>EQ_Scenario_DissidentesCoro</defName>
    <label>Desafinados</label>
    <description>No Coro Ascendente todos cantam a mesma nota. Vocês erraram a nota, de propósito, na frente de todo mundo. Antes que alguém viesse "reafinar" o naipe, já estavam longe.</description>
    <modExtensions>
      <li Class="EcosDaQueda.ScenarioXenotypesExtension">
        <xenotypeChances>
          <EQ_Xeno_Corista>0.7</EQ_Xeno_Corista>
          <EQ_Xeno_Vagante>0.3</EQ_Xeno_Vagante>
        </xenotypeChances>
      </li>
    </modExtensions>
    <scenario>
      <summary>Quatro coristas abandonam o Coro Ascendente. Começa malvisto por ele.</summary>
