  <!-- ===================== O SINDICATO DO SAQUE ===================== -->

  <PawnKindDef ParentName="MercenaryMidTierBase">
    <defName>EQ_Sindicato_Filiado</defName>
    <apparelMoney>100~350</apparelMoney>
    <apparelTags Inherit="False">
      <li>EQ_Roupa_Comum</li>
      <li>EQ_Roupa_Sindicato</li>
    </apparelTags>
    <label>filiado</label>
    <labelPlural>filiados</labelPlural>
    <!-- Bloco L (Vanilla Recycling Expanded): a "contribuição sindical" recolhida no caminho; cai como saque. -->
    <inventoryOptions Inherit="False">
      <subOptionsTakeAll>
        <li>
          <skipChance>0.9</skipChance>
          <thingDef>MedicineIndustrial</thingDef>
          <countRange>1</countRange>
        </li>
        <li MayRequire="VanillaExpanded.Recycling">
          <skipChance>0.4</skipChance>
          <thingDef>VRecyclingE_Trash</thingDef>
          <countRange>1~3</countRange>
        </li>
      </subOptionsTakeAll>
    </inventoryOptions>
    <defaultFactionDef>EQ_Faction_SindicatoDoSaque</defaultFactionDef>
    <combatPower>40</combatPower>
    <!-- Unidade de combate: nunca alguém incapaz de violência (viria desarmado). -->
