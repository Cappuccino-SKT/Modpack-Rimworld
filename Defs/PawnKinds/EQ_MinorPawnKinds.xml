  <!-- ===================== OS FORA DE LINHA (androides) ===================== -->

  <PawnKindDef ParentName="MercenaryMidTierBase">
    <defName>EQ_ForaDeLinha_Unidade</defName>
    <label>unidade autônoma</label>
    <labelPlural>unidades autônomas</labelPlural>
    <defaultFactionDef>EQ_Faction_ForaDeLinha</defaultFactionDef>
    <combatPower>65</combatPower>
    <apparelColor>(60,140,160)</apparelColor>
    <apparelMoney>500~1100</apparelMoney>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>IndustrialMilitaryBasic</li>
    </apparelTags>
    <!-- Unidade de combate: nunca alguém incapaz de violência (viria desarmado). -->
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
    <weaponMoney>300~900</weaponMoney>
    <weaponTags Inherit="False">
      <li>EQ_ForaDeLinha_Basico</li>
    </weaponTags>
    <initialResistanceRange>15~25</initialResistanceRange>
    <modExtensions>
      <!-- Munição de reserva com o Combat Extended (as bases MidTier/Elite do jogo não recebem do CE). -->
      <li Class="CombatExtended.LoadoutPropertiesExtension" MayRequire="CETeam.CombatExtended">
        <primaryMagazineCount>
          <min>2</min>
          <max>4</max>
        </primaryMagazineCount>
      </li>
    </modExtensions>
  </PawnKindDef>

