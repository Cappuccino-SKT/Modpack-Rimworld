  <!-- Ghoul da facção: tropa de choque dos ninhos (mutante do Anomaly). -->
  <PawnKindDef ParentName="MutantBase" MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>EQ_NaoCatalogado_Devorador</defName>
    <label>devorador</label>
    <labelPlural>devoradores</labelPlural>
    <defaultFactionDef>EQ_Faction_NaoCatalogados</defaultFactionDef>
    <mutant>Ghoul</mutant>
    <generateInitialNonFamilyRelations>false</generateInitialNonFamilyRelations>
    <combatPower>90</combatPower>
    <gearHealthRange>0.2~0.4</gearHealthRange>
