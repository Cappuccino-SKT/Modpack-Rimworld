<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    N2 (NACAO.md › 3.4): conselho da nação. Só depois da fundação (N1); botão "Conselho" no trono.
    - Cada cadeira tem um adulto livre (não o líder; um colono numa cadeira só). Bônus 0 na perícia skillZero, cheio na skillFull,
      e só vale com o conselheiro vivo, consciente e na colônia (o Embaixador também numa caravana).
    - Trocar quem ocupa uma cadeira: espera de swapCooldownDays dias (cadeira vaga por morte não espera).
    - Efeitos por canal (GovEffect): o fator de cada canal é 1 + soma de (amount × bônus da cadeira). Canais: goodwill, goodwillOtherIdeo,
      patronTension, ceremony, army, revolt, frontier, tribute, tributeFood, tributeMaterials, tributeSilver, markers (inteiro, com o
      bônus ≥ markerThreshold), workSpeed (bancadas), research, tradePrice (soma), quality (chance de +1 nível), yieldGreen, yieldHills; N2c/F5: ver EQ_Governo.xml e EQ_Ocupacao.xml (borderDefense).
      Cadeiras vindas dos memes: EQ_Governo.xml (N2b).
    - Embaixador (Social): boa vontade ganha +20%, tensão da patrona −30%, cerimônia e dízimos −15%. Vale também em caravana.
    - General (Tiro ou Corpo a corpo, a maior): exércitos sob comando do jogador +15%, revoltas futuras −20%; posto de ocupação
      contra o jogador com raio −25% (F5, canal borderDefense).
    - Conselheiro (Intelectual): fronteira +25%, tributo +25%, +1 marco por colônia (com o bônus em pelo menos 50%).
  -->
  <EcosDaQueda.CouncilDef>
    <defName>EQ_Conselho</defName>
    <label>conselho da nação</label>
    <skillZero>4</skillZero>
    <skillFull>15</skillFull>
    <swapCooldownDays>3</swapCooldownDays>
    <markerThreshold>0.5</markerThreshold>
    <seatStackBonus>0.5</seatStackBonus>
    <memberThought>EQ_ConselhoMembro</memberThought>
    <passedOverThought>EQ_ConselhoPreterido</passedOverThought>
    <seats>
      <li>
        <key>embaixador</key>
        <label>embaixador</label>
        <description>Social. Mais boa vontade com todas as facções, a tensão da patrona com as outras potências sobe mais devagar, cerimônia e dízimos mais baratos. Vale também em caravana.</description>
        <skills>
          <li>Social</li>
        </skills>
        <allowCaravan>true</allowCaravan>
        <effects>
          <li><channel>goodwill</channel><amount>0.20</amount></li>
          <li><channel>patronTension</channel><amount>-0.30</amount></li>
          <li><channel>ceremony</channel><amount>-0.15</amount></li>
        </effects>
      </li>
      <li>
        <key>general</key>
        <label>general</label>
        <description>Tiro ou Corpo a corpo (a maior). Exércitos sob o seu comando mais fortes; as próximas revoltas vêm menores.</description>
        <skills>
          <li>Shooting</li>
          <li>Melee</li>
        </skills>
        <effects>
          <li><channel>army</channel><amount>0.15</amount></li>
          <li><channel>revolt</channel><amount>-0.20</amount></li>
          <li><channel>borderDefense</channel><amount>0.25</amount></li>
        </effects>
      </li>
      <li>
        <key>conselheiro</key>
        <label>conselheiro</label>
        <description>Intelectual. A fronteira cresce mais rápido, o tributo do território rende mais e, com metade do bônus, cabe mais um marco por colônia.</description>
        <skills>
          <li>Intellectual</li>
        </skills>
        <effects>
          <li><channel>frontier</channel><amount>0.25</amount></li>
          <li><channel>tribute</channel><amount>0.25</amount></li>
          <li><channel>markers</channel><amount>1</amount></li>
        </effects>
      </li>
    </seats>
  </EcosDaQueda.CouncilDef>

  <ThoughtDef>
    <defName>EQ_ConselhoMembro</defName>
    <workerClass>EcosDaQueda.ThoughtWorker_EQCouncilMember</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>membro do conselho</label>
        <description>Tenho uma cadeira no conselho. Ninguém lê os meus pareceres, mas a cadeira é minha.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>EQ_ConselhoPreterido</defName>
    <workerClass>EcosDaQueda.ThoughtWorker_EQCouncilPassedOver</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>preterido no conselho</label>
        <description>Entendo do assunto muito mais do que quem senta naquela cadeira. Mas ninguém pergunta para mim.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
