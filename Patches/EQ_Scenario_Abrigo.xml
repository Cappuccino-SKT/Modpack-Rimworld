<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Etapa 2, bloco F: com o VQE Ancients, "Saídos do abrigo" começa dentro do abrigo selado do mod
       (ScenPart_SealedVault gera a estrutura e põe os colonos e os itens iniciais lá dentro; por isso sai a parte de
       chegada, que tentaria pô-los de novo). Com o VQE The Generator, peças do gerador do abrigo. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Quests Expanded - Ancients</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ScenarioDef[defName="EQ_Scenario_Abrigo"]/scenario/parts/li[@Class="ScenPart_PlayerPawnsArriveMethod"]</xpath>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ScenarioDef[defName="EQ_Scenario_Abrigo"]/scenario/parts</xpath>
          <order>Prepend</order>
          <value>
            <li Class="VanillaQuestsExpandedAncients.ScenPart_SealedVault">
              <def>VQEA_SealedVaultPart</def>
              <visible>false</visible>
              <structureSetDef>VQEA_SealedVaultUndergroundStructure</structureSetDef>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Quests Expanded - The Generator</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ScenarioDef[defName="EQ_Scenario_Abrigo"]/scenario/parts</xpath>
      <value>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>VQE_GenetronComponent</thingDef>
          <count>5</count>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
