<LanguageData>
  <!-- EN: minor UV sensitivity -->
  <AG_UVSensitivity_Minor.label>sensibilidade leve a UV</AG_UVSensitivity_Minor.label>
  <!-- EN: Carriers of this gene have eyes that are sensitive to UV radiation, making them mildly uncomfortable when in direct sunlight. -->
  <AG_UVSensitivity_Minor.description>Portadores deste gene têm olhos sensíveis à radiação UV, que os deixam um pouco desconfortáveis sob a luz direta do sol.</AG_UVSensitivity_Minor.description>
  <!-- EN: UV-sensitive -->
  <AG_UVSensitivity_Minor.labelShortAdj>sensível a UV</AG_UVSensitivity_Minor.labelShortAdj>
