<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- EN: painless -->
  <AG_Painless.label>sem dor</AG_Painless.label>
  <!-- EN: Carriers of this gene feel almost no pain compared to a baseliner. Reduced neuron activity in the brain's nociception centers makes pain almost nonexistent. This can be advantageous sometimes, and dangerous other times. -->
  <AG_Painless.description>Portadores deste gene quase não sentem dor comparados a um humano padrão. A atividade reduzida dos neurônios nos centros de nocicepção do cérebro torna a dor quase inexistente. Às vezes isso é vantajoso, às vezes perigoso.</AG_Painless.description>
  <!-- EN: painless -->
  <AG_Painless.labelShortAdj>indolor</AG_Painless.labelShortAdj>
  <!-- EN: dull -->
  <AG_Painless.symbolPack.prefixSymbols.0.symbol>dormente</AG_Painless.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: painless -->
  <AG_Painless.symbolPack.prefixSymbols.1.symbol>indolor</AG_Painless.symbolPack.prefixSymbols.1.symbol>
  <!-- EN: tough -->
  <AG_Painless.symbolPack.prefixSymbols.2.symbol>duro</AG_Painless.symbolPack.prefixSymbols.2.symbol>
  <!-- EN: brittle bones -->
  <AG_BrittleBones.label>ossos quebradiços</AG_BrittleBones.label>
  <!-- EN: Carriers of this gene have very frail, brittle bone structure. If they are downed in any way they'll suffer cracks and fractures in their bones. -->
  <AG_BrittleBones.description>Portadores deste gene têm uma estrutura óssea muito frágil e quebradiça. Se caírem de qualquer jeito, sofrem trincas e fraturas nos ossos.</AG_BrittleBones.description>
  <!-- EN: brittle -->
  <AG_BrittleBones.symbolPack.prefixSymbols.0.symbol>quebradiço</AG_BrittleBones.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: glass -->
  <AG_BrittleBones.symbolPack.prefixSymbols.1.symbol>vidro</AG_BrittleBones.symbolPack.prefixSymbols.1.symbol>
  <!-- EN: weak -->
  <AG_BrittleBones.symbolPack.prefixSymbols.2.symbol>fraco</AG_BrittleBones.symbolPack.prefixSymbols.2.symbol>
</LanguageData>
