  <!-- EN: forsaken body -->
  <AG_ForsakenBody.label>corpo de renegado</AG_ForsakenBody.label>
  <!-- EN: Carriers of this gene have a body that seems to have deep valleys around their bodies and ribs visible beneath the skin in certain places, yet are otherwise healthy in appearance. This results in a slightly lower weight and a significantly more fragile body. -->
  <AG_ForsakenBody.description>Portadores deste gene têm um corpo com sulcos profundos e costelas visíveis sob a pele em certos lugares, mas de aparência saudável no resto. Isso resulta num peso um pouco menor e num corpo bem mais frágil.</AG_ForsakenBody.description>
  <!-- EN: forsaken -->
  <AG_ForsakenBody.labelShortAdj>renegado</AG_ForsakenBody.labelShortAdj>
  <!-- EN: digitigrade legs -->
  <AG_Digitigrade.label>pernas digitígradas</AG_Digitigrade.label>
  <!-- EN: Carriers of this gene have digitigrade legs, meaning they stand or walk with their toes (metatarsals) touching the ground, and the rest of their foot lifted. -->
  <AG_Digitigrade.description>Portadores deste gene têm pernas digitígradas: ficam de pé e andam com os dedos (metatarsos) no chão e o resto do pé levantado.</AG_Digitigrade.description>
  <!-- EN: digitigrade -->
  <AG_Digitigrade.labelShortAdj>digitígrado</AG_Digitigrade.labelShortAdj>
