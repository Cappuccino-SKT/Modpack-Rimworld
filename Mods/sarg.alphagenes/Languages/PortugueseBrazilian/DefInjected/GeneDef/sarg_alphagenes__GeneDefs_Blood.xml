  <!-- EN: slimebleeder -->
  <AG_SlimeBlood.symbolPack.wholeNameSymbols.0.symbol>sangra-gosma</AG_SlimeBlood.symbolPack.wholeNameSymbols.0.symbol>
  <!-- EN: acidic blood -->
  <AG_AcidicBlood.label>sangue ácido</AG_AcidicBlood.label>
  <!-- EN: Carriers of this gene have extremely acidic blood. This blood doesn't harm them, but it will spill everywhere when they are slain, hurting all people nearby. -->
  <AG_AcidicBlood.description>Portadores deste gene têm sangue extremamente ácido. O sangue não os fere, mas espirra para todo lado quando morrem, ferindo todos por perto.</AG_AcidicBlood.description>
  <!-- EN: acid -->
  <AG_AcidicBlood.symbolPack.prefixSymbols.0.symbol>ácido</AG_AcidicBlood.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: caust -->
