  <AG_ForsakenBlood.label>sangue amarelo</AG_ForsakenBlood.label>
  <!-- EN: Carriers of this gene have yellow blood. -->
  <AG_ForsakenBlood.description>Portadores deste gene têm sangue amarelo.</AG_ForsakenBlood.description>
