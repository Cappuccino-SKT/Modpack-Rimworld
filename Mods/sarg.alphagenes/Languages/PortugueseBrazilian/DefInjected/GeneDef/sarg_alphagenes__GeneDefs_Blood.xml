  <!-- EN: xenomorph -->
  <AG_AcidicBlood.symbolPack.wholeNameSymbols.0.symbol>xenomorfo</AG_AcidicBlood.symbolPack.wholeNameSymbols.0.symbol>
  <!-- EN: tarlike blood -->
  <AG_TarBlood.label>sangue de piche</AG_TarBlood.label>
  <!-- EN: Carriers of this gene have very thick, dark and sticky blood, similar to tar. This blood impedes movement. -->
  <AG_TarBlood.description>Portadores deste gene têm sangue muito grosso, escuro e pegajoso, parecido com piche. Esse sangue atrapalha o movimento.</AG_TarBlood.description>
  <!-- EN: tar -->
  <AG_TarBlood.symbolPack.prefixSymbols.0.symbol>piche</AG_TarBlood.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: stick -->
