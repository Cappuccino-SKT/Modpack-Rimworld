  <AG_TarBlood.symbolPack.prefixSymbols.2.symbol>óleo</AG_TarBlood.symbolPack.prefixSymbols.2.symbol>
  <!-- EN: tarbleeder -->
  <AG_TarBlood.symbolPack.wholeNameSymbols.0.symbol>sangra-piche</AG_TarBlood.symbolPack.wholeNameSymbols.0.symbol>
  <!-- EN: insect blood -->
  <AG_InsectBlood.label>sangue de inseto</AG_InsectBlood.label>
  <!-- EN: Carriers of this gene have insect blood. -->
  <AG_InsectBlood.description>Portadores deste gene têm sangue de inseto.</AG_InsectBlood.description>
  <!-- EN: insect -->
  <AG_InsectBlood.symbolPack.prefixSymbols.0.symbol>inseto</AG_InsectBlood.symbolPack.prefixSymbols.0.symbol>
