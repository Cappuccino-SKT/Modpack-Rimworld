<LanguageData>
  <!-- EN: repulsive -->
  <AG_Beauty_VeryVeryUgly.label>repulsivo</AG_Beauty_VeryVeryUgly.label>
  <!-- EN: Carriers of this gene are so unfathomably ugly and grotesque that merely looking at them is enough to make other people nauseous. -->
  <AG_Beauty_VeryVeryUgly.description>Portadores deste gene são tão inimaginavelmente feios e grotescos que só de olhar para eles as outras pessoas ficam enjoadas.</AG_Beauty_VeryVeryUgly.description>
  <!-- EN: repulsive -->
  <AG_Beauty_VeryVeryUgly.labelShortAdj>repulsivo</AG_Beauty_VeryVeryUgly.labelShortAdj>
  <!-- EN: grim -->
  <AG_Beauty_VeryVeryUgly.symbolPack.prefixSymbols.0.symbol>sinistro</AG_Beauty_VeryVeryUgly.symbolPack.prefixSymbols.0.symbol>
