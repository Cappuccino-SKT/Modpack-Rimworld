  <!-- EN: unsettling appearance -->
  <AG_UnsettlingAppearance.label>aparência perturbadora</AG_UnsettlingAppearance.label>
  <!-- EN: Going beyond mundane notions of beauty or ugliness, the carrier of this gene has such an unsettling appearance that it inspires a certain sense of unease on other people. -->
  <AG_UnsettlingAppearance.description>Indo além das noções comuns de beleza ou feiura, o portador deste gene tem uma aparência tão perturbadora que causa certo desconforto nas outras pessoas.</AG_UnsettlingAppearance.description>
  <!-- EN: unsettling -->
  <AG_UnsettlingAppearance.labelShortAdj>perturbador</AG_UnsettlingAppearance.labelShortAdj>
  <!-- EN: uncanny -->
  <AG_UnsettlingAppearance.symbolPack.prefixSymbols.0.symbol>estranho</AG_UnsettlingAppearance.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: disturb -->
  <AG_UnsettlingAppearance.symbolPack.prefixSymbols.1.symbol>inquiet</AG_UnsettlingAppearance.symbolPack.prefixSymbols.1.symbol>
  <!-- EN: monst -->
