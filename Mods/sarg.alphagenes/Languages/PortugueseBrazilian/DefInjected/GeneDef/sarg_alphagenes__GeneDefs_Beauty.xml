  <!-- EN: fiend -->
  <AG_UnsettlingAppearance.symbolPack.prefixSymbols.3.symbol>demônio</AG_UnsettlingAppearance.symbolPack.prefixSymbols.3.symbol>
  <!-- EN: vile -->
  <AG_UnsettlingAppearance.symbolPack.prefixSymbols.4.symbol>vil</AG_UnsettlingAppearance.symbolPack.prefixSymbols.4.symbol>
  <!-- EN: eldritch visage -->
  <AG_EldritchVisage.label>semblante sobrenatural</AG_EldritchVisage.label>
  <!-- EN: The carrier of this gene has an appearance that terrifies other people to the very core of their being. They will always be despised. -->
  <AG_EldritchVisage.description>O portador deste gene tem uma aparência que aterroriza os outros até o âmago do ser. Será sempre desprezado.</AG_EldritchVisage.description>
  <!-- EN: eldritch -->
  <AG_EldritchVisage.labelShortAdj>sobrenatural</AG_EldritchVisage.labelShortAdj>
  <!-- EN: eldri -->
  <AG_EldritchVisage.symbolPack.prefixSymbols.0.symbol>eldri</AG_EldritchVisage.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: terror -->
  <AG_EldritchVisage.symbolPack.prefixSymbols.1.symbol>terror</AG_EldritchVisage.symbolPack.prefixSymbols.1.symbol>
  <!-- EN: teratophilia -->
  <AG_Teratophilia.label>teratofilia</AG_Teratophilia.label>
  <!-- EN: The carrier of this gene doesn't care about ugliness, feeling equally attracted to ugly colonists. Beauty is in the eye of the beholder after all (the person looking, not the D&amp;D monster). -->
  <AG_Teratophilia.description>O portador deste gene não liga para feiura e se sente igualmente atraído por colonos feios. Afinal, a beleza está nos olhos de quem vê (a pessoa olhando, não o monstro de D&amp;D).</AG_Teratophilia.description>
</LanguageData>
