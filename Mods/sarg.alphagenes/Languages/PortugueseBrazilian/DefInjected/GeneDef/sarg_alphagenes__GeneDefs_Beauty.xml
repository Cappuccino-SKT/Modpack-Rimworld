  <!-- EN: angelic beauty -->
  <AG_Beauty_Angelic.label>beleza angelical</AG_Beauty_Angelic.label>
  <!-- EN: Carriers of this gene possess an unnatural, almost pristine beauty that makes them stand out among others of their kind. -->
  <AG_Beauty_Angelic.description>Portadores deste gene têm uma beleza antinatural, quase imaculada, que os destaca entre os da sua espécie.</AG_Beauty_Angelic.description>
  <!-- EN: angelic -->
  <AG_Beauty_Angelic.labelShortAdj>angelical</AG_Beauty_Angelic.labelShortAdj>
