<LanguageData>
  <!-- EN: plagued claw -->
  <AG_PlaguedClaws_Hands.label>garra pestilenta</AG_PlaguedClaws_Hands.label>
  <!-- EN: A plagued claw that will transmit the shambler plague. -->
  <AG_PlaguedClaws_Hands.description>Uma garra pestilenta que transmite a praga trôpega.</AG_PlaguedClaws_Hands.description>
  <!-- EN: plagued claw -->
  <AG_PlaguedClaws_Hands.comps.HediffComp_VerbGiver.tools.plagued_claw.label>garra pestilenta</AG_PlaguedClaws_Hands.comps.HediffComp_VerbGiver.tools.plagued_claw.label>
  <!-- EN: greater toughspikes -->
  <AG_GreaterToughspikes.label>grandes espinhos duros</AG_GreaterToughspikes.label>
  <!-- EN: Four functional toughspike claws growing from the back that can be used in melee attacks. -->
  <AG_GreaterToughspikes.description>Quatro garras funcionais de espinho duro saindo das costas, que podem ser usadas em ataques corpo a corpo.</AG_GreaterToughspikes.description>
  <!-- EN: greater toughspikes -->
  <AG_GreaterToughspikes.comps.HediffComp_VerbGiver.tools.greater_toughspikes-0.label>grandes espinhos duros</AG_GreaterToughspikes.comps.HediffComp_VerbGiver.tools.greater_toughspikes-0.label>
  <!-- EN: greater toughspikes -->
  <AG_GreaterToughspikes.comps.HediffComp_VerbGiver.tools.greater_toughspikes-1.label>grandes espinhos duros</AG_GreaterToughspikes.comps.HediffComp_VerbGiver.tools.greater_toughspikes-1.label>
  <!-- EN: greater flesh whip -->
  <AG_GreaterFleshWhip.label>grande chicote de carne</AG_GreaterFleshWhip.label>
  <!-- EN: Two fleshy, muscled tentacles with blades at the end. These flesh whips make for excellent melee weapons. -->
  <AG_GreaterFleshWhip.description>Dois tentáculos carnudos e musculosos com lâminas na ponta. Esses chicotes de carne são excelentes armas corpo a corpo.</AG_GreaterFleshWhip.description>
  <!-- EN: greater flesh whip -->
  <AG_GreaterFleshWhip.comps.HediffComp_VerbGiver.tools.greater_flesh_whip.label>grande chicote de carne</AG_GreaterFleshWhip.comps.HediffComp_VerbGiver.tools.greater_flesh_whip.label>
  <!-- EN: flesh spitter -->
  <AG_FleshSpitter.label>cuspidor de carne</AG_FleshSpitter.label>
  <!-- EN: A grotesque, cancerous growth on the shoulder than can spit acid on its own volition. -->
  <AG_FleshSpitter.description>Um crescimento grotesco e canceroso no ombro que cospe ácido por vontade própria.</AG_FleshSpitter.description>
  <!-- EN: acid spit -->
  <AG_FleshSpitter.comps.HediffComp_ExtendedVerbGiver.verbProps.0.label>cuspe ácido</AG_FleshSpitter.comps.HediffComp_ExtendedVerbGiver.verbProps.0.label>
  <!-- EN: acid spit -->
  <AG_FleshSpitter.comps.HediffComp_ExtendedVerbGiver.verbs.acid_spit.label>cuspe ácido</AG_FleshSpitter.comps.HediffComp_ExtendedVerbGiver.verbs.acid_spit.label>
