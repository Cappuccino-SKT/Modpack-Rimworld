  <!-- EN: cold-blooded -->
  <VRESaurids_ColdBlooded.symbolPack.wholeNameSymbols.0.symbol>sangue-frio</VRESaurids_ColdBlooded.symbolPack.wholeNameSymbols.0.symbol>
  <!-- EN: pheromones -->
  <VRESaurids_Pheromones.label>feromônios</VRESaurids_Pheromones.label>
  <!-- EN: Carriers of this gene excrete special pheromones that attract members of the same xenotype. -->
  <VRESaurids_Pheromones.description>Portadores deste gene liberam feromônios especiais que atraem membros do mesmo xenotipo.</VRESaurids_Pheromones.description>
