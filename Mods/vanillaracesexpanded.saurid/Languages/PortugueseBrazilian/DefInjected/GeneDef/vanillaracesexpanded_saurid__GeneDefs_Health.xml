  <!-- EN: oviparous -->
  <VRESaurids_Oviparous.label>ovíparo</VRESaurids_Oviparous.label>
  <!-- EN: Carriers of this gene lay eggs instead of giving live birth. Eggs need time and correct conditions to hatch.\n   -->
  <VRESaurids_Oviparous.description>Portadores deste gene botam ovos em vez de dar à luz. Os ovos precisam de tempo e das condições certas para eclodir.\n</VRESaurids_Oviparous.description>
  <!-- EN: egg -->
  <VRESaurids_Oviparous.symbolPack.prefixSymbols.0.symbol>ovo</VRESaurids_Oviparous.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: bud -->
