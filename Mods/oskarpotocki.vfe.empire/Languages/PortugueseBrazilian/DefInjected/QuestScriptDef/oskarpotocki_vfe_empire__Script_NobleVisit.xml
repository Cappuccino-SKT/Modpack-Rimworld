    <li>lodgersWasWere(nobleCount==1)-&gt;foi</li>
    <!-- EN: lodgersWasWere(nobleCount&gt;=2)-&gt;were -->
    <li>lodgersWasWere(nobleCount&gt;=2)-&gt;foram</li>
    <!-- EN: appreciateAppreciates(nobleCount==1)-&gt;appreciates -->
