<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- EN: High-priority hauling. Works like the regular kind, but only for things that are manually designated. Use &lt;b&gt;Architect &gt; Orders &gt; Haul Urgently&lt;/b&gt; to designate things to haul.\nAdded by the Allow Tool mod. Can be disabled in Options &gt; Mod Settings. -->
  <HaulingUrgent.description>Transporte de alta prioridade. Funciona como o comum, mas só para coisas marcadas à mão. Use &lt;b&gt;Arquiteto &gt; Ordens &gt; Carregar com urgência&lt;/b&gt; para marcar o que carregar.\nAdicionado pelo mod Allow Tool. Pode ser desligado em Opções &gt; Configurações dos mods.</HaulingUrgent.description>
  <!-- EN: Hauling urgently -->
  <HaulingUrgent.gerundLabel>Carregando com urgência</HaulingUrgent.gerundLabel>
  <!-- EN: Haul+ -->
  <HaulingUrgent.labelShort>Carregar+</HaulingUrgent.labelShort>
  <!-- EN: Urgent hauler -->
  <HaulingUrgent.pawnLabel>Carregador urgente</HaulingUrgent.pawnLabel>
  <!-- EN: Haul urgently -->
  <HaulingUrgent.verb>Carregar com urgência</HaulingUrgent.verb>
  <!-- EN: Quickly and painlessly kill downed creatures.\nAdded by the Allow Tool mod. Can be disabled in Options &gt; Mod Settings. -->
  <FinishingOff.description>Mata de forma rápida e indolor criaturas caídas.\nAdicionado pelo mod Allow Tool. Pode ser desligado em Opções &gt; Configurações dos mods.</FinishingOff.description>
  <!-- EN: Finishing off -->
  <FinishingOff.gerundLabel>Dando o golpe final</FinishingOff.gerundLabel>
  <!-- EN: Finish -->
  <FinishingOff.labelShort>Golpe final</FinishingOff.labelShort>
  <!-- EN: Executor -->
  <FinishingOff.pawnLabel>Executor</FinishingOff.pawnLabel>
  <!-- EN: Finish off -->
  <FinishingOff.verb>Dar o golpe final</FinishingOff.verb>
</LanguageData>
