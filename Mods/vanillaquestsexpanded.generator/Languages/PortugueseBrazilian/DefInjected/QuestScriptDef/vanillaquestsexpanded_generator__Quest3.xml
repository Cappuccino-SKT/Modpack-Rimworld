    <!-- EN: terminalStudiedMessage-&gt;Terminal studied. You've collected the information and can now leave. -->
    <li>terminalStudiedMessage-&gt;Terminal estudado. Você reuniu as informações e já pode ir embora.</li>
  </VQE_AncientARC.questContentRules.rulesStrings>
  <VQE_AncientARC.questDescriptionRules.rulesStrings>
