  <!-- EN: oxygen sensitivity -->
  <VREStarjack_OxygenSensitivity_Mild.stages.oxygen_sensitivity.label>sensibilidade ao oxigênio</VREStarjack_OxygenSensitivity_Mild.stages.oxygen_sensitivity.label>
