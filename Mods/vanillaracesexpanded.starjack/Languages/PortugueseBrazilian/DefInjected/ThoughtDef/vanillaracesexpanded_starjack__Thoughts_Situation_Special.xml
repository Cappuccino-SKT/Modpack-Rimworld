  <!-- EN: oxygen sensitivity -->
  <VREStarjack_OxygenSensitivity_Extreme.stages.oxygen_sensitivity.label>sensibilidade ao oxigênio</VREStarjack_OxygenSensitivity_Extreme.stages.oxygen_sensitivity.label>
