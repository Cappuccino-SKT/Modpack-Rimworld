  <!-- EN: oxygen sensitivity -->
  <VREStarjack_OxygenSensitivity_Intense.stages.oxygen_sensitivity.label>sensibilidade ao oxigênio</VREStarjack_OxygenSensitivity_Intense.stages.oxygen_sensitivity.label>
