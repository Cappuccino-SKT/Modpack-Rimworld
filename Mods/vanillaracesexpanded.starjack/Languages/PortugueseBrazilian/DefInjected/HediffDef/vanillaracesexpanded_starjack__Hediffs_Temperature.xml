<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- EN: cryostasis -->
  <VREStarjack_CryostasisHediff.label>criostase</VREStarjack_CryostasisHediff.label>
  <!-- EN: This person does not suffer fatal hypothermia. Instead, their bodies gradually slow down and enter a dormant state when exposed to extreme cold, and they can awaken safely once warmed. -->
  <VREStarjack_CryostasisHediff.description>Esta pessoa não sofre hipotermia fatal. Em vez disso, o corpo desacelera aos poucos e entra em dormência quando exposto a frio extremo, e ela acorda com segurança quando aquecida.</VREStarjack_CryostasisHediff.description>
  <!-- EN: shivering -->
  <VREStarjack_CryostasisHediff.stages.shivering.label>tremendo</VREStarjack_CryostasisHediff.stages.shivering.label>
  <!-- EN: initial -->
  <VREStarjack_CryostasisHediff.stages.initial.label>inicial</VREStarjack_CryostasisHediff.stages.initial.label>
  <!-- EN: drowsy -->
  <VREStarjack_CryostasisHediff.stages.drowsy.label>sonolento</VREStarjack_CryostasisHediff.stages.drowsy.label>
  <!-- EN: sleep -->
  <VREStarjack_CryostasisHediff.stages.sleep.label>adormecido</VREStarjack_CryostasisHediff.stages.sleep.label>
  <!-- EN: deep sleep -->
  <VREStarjack_CryostasisHediff.stages.deep_sleep.label>sono profundo</VREStarjack_CryostasisHediff.stages.deep_sleep.label>
</LanguageData>
