  <!-- EN: God of Courage -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.20.type>Deus da Coragem</VFEM2_Structure_Norse.fixedDeityNameTypes.20.type>
  <!-- EN: Fire Giant and Harbinger of Ragnarok -->
