  <VFEM2_Structure_Norse.fixedDeityNameTypes.7.type>Deus da Fertilidade e da Paz</VFEM2_Structure_Norse.fixedDeityNameTypes.7.type>
  <!-- EN: God of the Sea and Wealth -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.8.type>Deus do Mar e da Riqueza</VFEM2_Structure_Norse.fixedDeityNameTypes.8.type>
  <!-- EN: Goddess of Winter and Hunting -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.9.type>Deusa do Inverno e da Caça</VFEM2_Structure_Norse.fixedDeityNameTypes.9.type>
