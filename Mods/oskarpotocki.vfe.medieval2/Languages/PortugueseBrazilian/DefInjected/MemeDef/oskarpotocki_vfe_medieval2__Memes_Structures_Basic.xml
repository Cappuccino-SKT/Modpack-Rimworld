  <VFEM2_Structure_Norse.fixedDeityNameTypes.14.type>Deusa da Juventude Eterna</VFEM2_Structure_Norse.fixedDeityNameTypes.14.type>
  <!-- EN: God of Poetry and Eloquence -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.15.type>Deus da Poesia e da Eloquência</VFEM2_Structure_Norse.fixedDeityNameTypes.15.type>
  <!-- EN: Goddess of Fidelity -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.16.type>Deusa da Fidelidade</VFEM2_Structure_Norse.fixedDeityNameTypes.16.type>
  <!-- EN: God of Vengeance and Silence -->
