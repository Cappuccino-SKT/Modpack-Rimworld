  <!-- EN: norse -->
  <VFEM2_Structure_Norse.label>nórdico</VFEM2_Structure_Norse.label>
  <!-- EN: This ideoligion is a descendant of Germanic paganism, also known as Asatru. It may have very different precepts than those of thousands of years ago, but its symbols are similar. -->
  <VFEM2_Structure_Norse.description>Esta ideoligião descende do paganismo germânico, também conhecido como Ásatrú. Seus preceitos podem ser bem diferentes dos de milhares de anos atrás, mas os símbolos são parecidos.</VFEM2_Structure_Norse.description>
  <!-- EN: Allfather and God of Wisdom -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.0.type>Pai de Todos e Deus da Sabedoria</VFEM2_Structure_Norse.fixedDeityNameTypes.0.type>
  <!-- EN: God of Thunder and Strength -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.1.type>Deus do Trovão e da Força</VFEM2_Structure_Norse.fixedDeityNameTypes.1.type>
  <!-- EN: Goddess of Marriage and Prophecy -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.2.type>Deusa do Casamento e da Profecia</VFEM2_Structure_Norse.fixedDeityNameTypes.2.type>
  <!-- EN: God of Mischief and Trickery -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.3.type>Deus da Travessura e da Trapaça</VFEM2_Structure_Norse.fixedDeityNameTypes.3.type>
