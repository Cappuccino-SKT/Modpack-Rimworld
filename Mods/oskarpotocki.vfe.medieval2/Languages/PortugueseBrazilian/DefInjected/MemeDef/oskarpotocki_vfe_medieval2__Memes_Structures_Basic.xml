  <!-- EN: God of the Ocean -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.25.type>Deus do Oceano</VFEM2_Structure_Norse.fixedDeityNameTypes.25.type>
  <!-- EN: Dragon of Yggdrasil's Roots -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.26.type>Dragão das Raízes de Yggdrasil</VFEM2_Structure_Norse.fixedDeityNameTypes.26.type>
  <!-- EN: Goddess of Sorcery -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.27.type>Deusa da Feitiçaria</VFEM2_Structure_Norse.fixedDeityNameTypes.27.type>
  <!-- EN: God of Inspiration -->
  <VFEM2_Structure_Norse.fixedDeityNameTypes.28.type>Deus da Inspiração</VFEM2_Structure_Norse.fixedDeityNameTypes.28.type>
