    <li>questName-&gt;Ajudar [askerFaction_name] na batalha</li>
    <!-- EN: questName-&gt;[askerFaction_name] clashes with [enemy_faction_name] -->
    <li>questName-&gt;[askerFaction_name] contra [enemy_faction_name]</li>
    <!-- EN: questName-&gt;[askerFaction_name]'s fight -->
    <li>questName-&gt;A luta de [askerFaction_name]</li>
    <!-- EN: questName-&gt;Battle for [askerFaction_name] -->
    <li>questName-&gt;Batalha por [askerFaction_name]</li>
    <!-- EN: questName-&gt;[askerFaction_name]'s call to arms -->
    <li>questName-&gt;[askerFaction_name] chama às armas</li>
    <!-- EN: questName-&gt;Defend [askerFaction_name] -->
    <li>questName-&gt;Defender [askerFaction_name]</li>
    <!-- EN: questName-&gt;Support [askerFaction_name] -->
    <li>questName-&gt;Apoiar [askerFaction_name]</li>
    <!-- EN: questName-&gt;[askerFaction_name]'s Skirmish -->
    <li>questName-&gt;Escaramuça de [askerFaction_name]</li>
