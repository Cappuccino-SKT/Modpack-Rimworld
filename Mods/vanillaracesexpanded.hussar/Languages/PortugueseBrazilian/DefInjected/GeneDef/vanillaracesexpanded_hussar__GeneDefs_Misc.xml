<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- EN: dutiful -->
  <VREH_Dutiful.label>obediente</VREH_Dutiful.label>
  <!-- EN: Carriers of this gene have a greatly increased sense of duty and will never break down when drafted. -->
  <VREH_Dutiful.description>Portadores deste gene têm um senso de dever muito maior e nunca sofrem colapsos mentais quando convocados.</VREH_Dutiful.description>
  <!-- EN: obedient -->
  <VREH_Dutiful.symbolPack.prefixSymbols.0.symbol>obediente</VREH_Dutiful.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: loyal -->
  <VREH_Dutiful.symbolPack.prefixSymbols.1.symbol>leal</VREH_Dutiful.symbolPack.prefixSymbols.1.symbol>
  <!-- EN: dutiful -->
  <VREH_Dutiful.symbolPack.prefixSymbols.2.symbol>zeloso</VREH_Dutiful.symbolPack.prefixSymbols.2.symbol>
  <!-- EN: steadfast -->
  <VREH_Dutiful.symbolPack.prefixSymbols.3.symbol>firme</VREH_Dutiful.symbolPack.prefixSymbols.3.symbol>
  <!-- EN: steady -->
  <VREH_Dutiful.symbolPack.prefixSymbols.4.symbol>estável</VREH_Dutiful.symbolPack.prefixSymbols.4.symbol>
  <!-- EN: composed -->
  <VREH_Dutiful.symbolPack.prefixSymbols.5.symbol>sereno</VREH_Dutiful.symbolPack.prefixSymbols.5.symbol>
  <!-- EN: bulletproof skin -->
  <VREH_BulletproofSkin.label>pele à prova de balas</VREH_BulletproofSkin.label>
  <!-- EN: Carriers of this gene have their skin reinforced by organic kevlar-like strands, allowing them to deflect smaller calliber bullets and only end up with bruises. -->
  <VREH_BulletproofSkin.description>Portadores deste gene têm a pele reforçada por fibras orgânicas parecidas com kevlar, o que permite desviar balas de calibre menor e ficar só com hematomas.</VREH_BulletproofSkin.description>
  <!-- EN: kevlar -->
  <VREH_BulletproofSkin.symbolPack.prefixSymbols.0.symbol>kevlar</VREH_BulletproofSkin.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: resistant -->
  <VREH_BulletproofSkin.symbolPack.suffixSymbols.0.symbol>resistente</VREH_BulletproofSkin.symbolPack.suffixSymbols.0.symbol>
  <!-- EN: bulletproof -->
  <VREH_BulletproofSkin.symbolPack.wholeNameSymbols.0.symbol>blindado</VREH_BulletproofSkin.symbolPack.wholeNameSymbols.0.symbol>
  <!-- EN: giant -->
  <VREH_Giant.label>gigante</VREH_Giant.label>
  <!-- EN: Carriers of this gene are slightly larger than baseline humans. -->
  <VREH_Giant.description>Portadores deste gene são um pouco maiores que humanos padrão.</VREH_Giant.description>
  <!-- EN: toughness -->
  <VREH_Toughness.label>resistência</VREH_Toughness.label>
  <!-- EN: Carriers of this gene have thick skin, dense flesh, and durable bones, and take much less damage than other people from the same blows. -->
  <VREH_Toughness.description>Portadores deste gene têm pele grossa, carne densa e ossos duráveis, e sofrem muito menos dano que outras pessoas com os mesmos golpes.</VREH_Toughness.description>
  <!-- EN: hard -->
  <VREH_Toughness.symbolPack.prefixSymbols.0.symbol>duro</VREH_Toughness.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: tough -->
  <VREH_Toughness.symbolPack.prefixSymbols.1.symbol>rijo</VREH_Toughness.symbolPack.prefixSymbols.1.symbol>
  <!-- EN: heavy -->
  <VREH_Toughness.symbolPack.prefixSymbols.2.symbol>pesado</VREH_Toughness.symbolPack.prefixSymbols.2.symbol>
  <!-- EN: strong -->
  <VREH_Toughness.symbolPack.prefixSymbols.3.symbol>forte</VREH_Toughness.symbolPack.prefixSymbols.3.symbol>
  <!-- EN: arrogant -->
  <VREH_Arrogant.label>arrogante</VREH_Arrogant.label>
  <!-- EN: Carriers of this gene do not have a filter and always say what's on their mind, even if it rubs the others the wrong way. -->
  <VREH_Arrogant.description>Portadores deste gene não têm filtro e sempre dizem o que pensam, mesmo que isso irrite os outros.</VREH_Arrogant.description>
  <!-- EN: rude -->
  <VREH_Arrogant.symbolPack.prefixSymbols.0.symbol>rude</VREH_Arrogant.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: evil -->
  <VREH_Arrogant.symbolPack.prefixSymbols.1.symbol>malvado</VREH_Arrogant.symbolPack.prefixSymbols.1.symbol>
  <!-- EN: mean -->
  <VREH_Arrogant.symbolPack.prefixSymbols.2.symbol>cruel</VREH_Arrogant.symbolPack.prefixSymbols.2.symbol>
  <!-- EN: arrogant -->
  <VREH_Arrogant.symbolPack.wholeNameSymbols.0.symbol>arrogante</VREH_Arrogant.symbolPack.wholeNameSymbols.0.symbol>
  <!-- EN: unconstrained -->
  <VREH_Unconstrained.label>desimpedido</VREH_Unconstrained.label>
  <!-- EN: Carriers of this gene do not suffer movement speed penalties caused by wearing clothing that would normally slow them down. -->
  <VREH_Unconstrained.description>Portadores deste gene não sofrem a perda de velocidade causada por roupas que normalmente os deixariam mais lentos.</VREH_Unconstrained.description>
  <!-- EN: luciferium dependency -->
  <VREH_ChemicalDependency_Luciferium.label>dependência de lucifério</VREH_ChemicalDependency_Luciferium.label>
  <!-- EN: Carriers of this gene need to ingest Luciferium on a regular basis to survive. After 10 days without luciferium, carriers will suffer from luciferium deficiency. After 20 days, they will fall into a coma. After 30 days, they will die. -->
  <VREH_ChemicalDependency_Luciferium.description>Portadores deste gene precisam ingerir lucifério regularmente para sobreviver. Após 10 dias sem lucifério, sofrem de deficiência de lucifério. Após 20 dias, entram em coma. Após 30 dias, morrem.</VREH_ChemicalDependency_Luciferium.description>
  <!-- EN: luciferium-dependent -->
  <VREH_ChemicalDependency_Luciferium.labelShortAdj>dependente de lucifério</VREH_ChemicalDependency_Luciferium.labelShortAdj>
  <!-- EN: luci -->
  <VREH_ChemicalDependency_Luciferium.symbolPack.prefixSymbols.0.symbol>luci</VREH_ChemicalDependency_Luciferium.symbolPack.prefixSymbols.0.symbol>
  <!-- EN: ferium -->
  <VREH_ChemicalDependency_Luciferium.symbolPack.suffixSymbols.0.symbol>ferium</VREH_ChemicalDependency_Luciferium.symbolPack.suffixSymbols.0.symbol>
  <!-- EN: devil -->
  <VREH_ChemicalDependency_Luciferium.symbolPack.suffixSymbols.1.symbol>diabo</VREH_ChemicalDependency_Luciferium.symbolPack.suffixSymbols.1.symbol>
  <!-- EN: glidewings -->
  <VREH_Glidewings.label>asas planadoras</VREH_Glidewings.label>
  <!-- EN: Carriers of this gene grow a small set of wings from their shoulderblades. They are not capable of flight, but they will not be slowed down by any obstacles. -->
  <VREH_Glidewings.description>Portadores deste gene têm um pequeno par de asas saindo das omoplatas. Não conseguem voar, mas nenhum obstáculo os deixa mais lentos.</VREH_Glidewings.description>
</LanguageData>
