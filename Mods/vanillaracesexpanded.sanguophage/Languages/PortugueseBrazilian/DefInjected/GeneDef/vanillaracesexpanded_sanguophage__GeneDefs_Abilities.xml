  <!-- EN: hemosmosis -->
  <VRE_Hemosmosis.label>hemosmose</VRE_Hemosmosis.label>
  <!-- EN: Carriers of this gene are able to drain blood from their environment, provided there is blood to be drained there. -->
  <VRE_Hemosmosis.description>Portadores deste gene conseguem drenar o sangue do ambiente, desde que haja sangue para drenar.</VRE_Hemosmosis.description>
