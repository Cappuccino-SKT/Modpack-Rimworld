  <!-- EN: filter infection -->
  <VRE_FilterInfection.label>filtrar infecção</VRE_FilterInfection.label>
  <!-- EN: Carriers of this gene have special glands in their mouths that allow them to filter infected blood from the clean blood. -->
  <VRE_FilterInfection.description>Portadores deste gene têm glândulas especiais na boca que permitem separar o sangue infectado do sangue limpo.</VRE_FilterInfection.description>
