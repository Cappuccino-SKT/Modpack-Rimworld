  <!-- EN: ecstasy -->
  <VRE_Ecstasy.label>êxtase</VRE_Ecstasy.label>
  <!-- EN: Carriers of this gene can psychically connect with the target briefly, granting them a sense of ecstasy and making them fall in love with the caster. -->
  <VRE_Ecstasy.description>Portadores deste gene conseguem se conectar psiquicamente ao alvo por um instante, dando-lhe uma sensação de êxtase e fazendo-o se apaixonar por quem usou a habilidade.</VRE_Ecstasy.description>
