  <!-- EN: heart crush -->
  <VRE_HeartCrush.label>esmagar coração</VRE_HeartCrush.label>
  <!-- EN: Carriers of this gene have special adrenaline glands that allow them to find the beating heart of the opponent and rip it out in a mad fury.  -->
  <VRE_HeartCrush.description>Portadores deste gene têm glândulas especiais de adrenalina que permitem encontrar o coração pulsante do oponente e arrancá-lo numa fúria insana.</VRE_HeartCrush.description>
