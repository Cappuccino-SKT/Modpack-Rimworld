	<ideo>
		<overriddenWorshipRoomLabel>abyssal sanctum</overriddenWorshipRoomLabel>
		<foundation Class="IdeoFoundation_Deity">
			<def>Deity</def>
			<place>Chelis</place>
			<deities>
				<li>
					<name>O Revisor</name>
					<type>Aquele que Lê Tudo</type>
