	<ideo>
		<foundation Class="IdeoFoundation_Deity">
			<def>Deity</def>
			<place>Wavia</place>
			<deities>
				<li>
					<name>O Acionista Majoritário</name>
					<type>Dono de Todas as Patentes</type>
